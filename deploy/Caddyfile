# Internal router behind Traefik. Traefik terminates HTTPS (and gets the certificate);
# Caddy listens on plain HTTP inside Docker and routes /api, SSE and the frontend.
{
	auto_https off
	servers {
		# Requests arrive from Traefik on a private Docker network. Trusting it keeps the real
		# client IP first in X-Forwarded-For (rate limiting depends on it) and keeps
		# X-Forwarded-Proto=https.
		trusted_proxies static private_ranges
	}
}

:80 {
	@www host www.{$DOMAIN}
	redir @www https://{$DOMAIN}{uri} permanent

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Server-Sent Events: no compression, no buffering, long-lived connection.
	@events path_regexp events ^/api/runs/[A-Za-z0-9]+/events$
	handle @events {
		reverse_proxy backend:8000 {
			flush_interval -1
			transport http {
				read_timeout 0
			}
		}
	}

	handle /api/* {
		encode zstd gzip
		reverse_proxy backend:8000
	}

	handle {
		encode zstd gzip
		reverse_proxy frontend:3000
	}

	log {
		output stdout
		format json
	}
}
