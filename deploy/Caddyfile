{
	email {$ACME_EMAIL}
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN} {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Server-Sent Events: no compression, no buffering, long-lived connection.
	@events path_regexp events ^/api/runs/[A-Za-z0-9]+/events$
	handle @events {
		reverse_proxy backend:8000 {
			flush_interval -1
			transport http {
				read_timeout 0
			}
		}
	}

	handle /api/* {
		encode zstd gzip
		reverse_proxy backend:8000
	}

	handle {
		encode zstd gzip
		reverse_proxy frontend:3000
	}

	log {
		output stdout
		format json
	}
}
