# =====================================================================
# LaunchScout environment configuration
# Copy to `.env` and fill in. NEVER commit `.env`.
# =====================================================================

# ---------- LLM (any LiteLLM-supported provider via CrewAI) ----------
# Examples: anthropic/claude-sonnet-5-5, openai/gpt-4.1, gemini/gemini-2.5-pro
LLM_MODEL=anthropic/claude-sonnet-5-5
# Sampling temperature for all agents (low = more factual)
LLM_TEMPERATURE=0.2
# Provide the key that matches your LLM_MODEL provider (only one needed)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# ---------- Search ----------
# https://serper.dev — used by SerperDevTool (Market Researcher + Review Analyst)
SERPER_API_KEY=
# Country / locale bias for Google search results
SERPER_COUNTRY=in
SERPER_LOCALE=en

# ---------- Crew behaviour ----------
# sequential (spec default) | hierarchical (stretch, feature flag)
PROCESS_MODE=sequential
# Max retries for the task-1 guardrail
GUARDRAIL_MAX_RETRIES=2
# Hard timeout per run, seconds
RUN_TIMEOUT_SECONDS=900
# Where report.md files are written (inside container: /app/outputs)
OUTPUTS_DIR=outputs
# Log crew internals verbosely (true/false)
CREW_VERBOSE=false

# ---------- Database / queue ----------
# Async SQLAlchemy URL
DATABASE_URL=postgresql+asyncpg://launchscout:launchscout@postgres:5432/launchscout
POSTGRES_USER=launchscout
POSTGRES_PASSWORD=launchscout
POSTGRES_DB=launchscout
REDIS_URL=redis://redis:6379/0

# ---------- API hardening ----------
# Runs allowed per IP, e.g. "5/hour"
RATE_LIMIT_RUNS=5/hour
# Maximum crews executing at the same time (worker concurrency)
MAX_CONCURRENT_RUNS=2
# Comma-separated allowed browser origins (lock to your domain in prod)
CORS_ORIGINS=http://localhost:3000
# Max characters for the idea / target customer fields
MAX_INPUT_CHARS=300
# Trust X-Forwarded-For from the reverse proxy (true behind Caddy)
TRUST_PROXY_HEADERS=false
# JSON logs (true) or human-readable (false)
LOG_JSON=true
LOG_LEVEL=INFO

# ---------- Optional Cloudflare Turnstile captcha ----------
TURNSTILE_ENABLED=false
TURNSTILE_SECRET_KEY=
# Public site key (safe to expose; baked into the frontend build)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ---------- Stretch feature flags ----------
FEATURE_PITCH_DECK=false
FEATURE_WEEKLY_RERUN=false

# ---------- Frontend ----------
# Base URL the browser uses for the API. Empty = same origin (prod behind Caddy).
NEXT_PUBLIC_API_BASE=
# Server-side URL the Next.js server uses to reach the API (inside docker network)
API_INTERNAL_URL=http://backend:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- Production deploy (Caddy) ----------
DOMAIN=launchscout.example.com
ACME_EMAIL=you@example.com
